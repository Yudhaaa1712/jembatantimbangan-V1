{
  "name": "weighbridge-sorek-bgr",
  "version": "1.2.7",
  "description": "Weighbridge - sorek-bgr | Sistem Jembatan Timbangan Sawit",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "node scripts/clean-db.js",
    "build": "electron-builder build --win",
    "build:dir": "electron-builder build --win --dir",
    "test": "jest",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "weighbridge",
    "timbangan",
    "sawit"
  ],
  "author": "Arroyan Jv Teknik",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^8.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsdom": "^29.1.1",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "build": {
    "appId": "com.arroyan.weighbridge.sorek-bgr",
    "productName": "Weighbridge - sorek-bgr",
    "copyright": "Copyright © 2024 Arroyan Jv Teknik",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraFiles": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Weighbridge sorek-bgr",
      "license": "build-resources/license.txt",
      "installerLanguages": [
        "id"
      ],
      "language": "1057"
    }
  }
}
