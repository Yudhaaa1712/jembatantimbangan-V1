digraph AlurSistem {
  rankdir=TB;
  bgcolor="white";
  splines=polyline;
  nodesep=0.45;
  ranksep=0.40;
  node [fontname="Arial", fontsize=11, style="filled", penwidth=1.2, color="#1f3864"];
  edge [fontname="Arial", fontsize=9, color="#1f3864", penwidth=1.1, arrowsize=0.8];

  start   [label="MULAI", shape=oval, fillcolor="#d9e2f3", height=0.45];
  reg     [label="Registrasi / Login", shape=box, fillcolor="#ffffff"];
  cek     [label="Data\nvalid?", shape=diamond, fillcolor="#fff2cc", height=1.0, width=1.5];
  kp      [label="Mengisi Kuesioner Profil\n(demografi, jenjang, gaya belajar)", shape=box, fillcolor="#ffffff"];
  kb      [label="Mengisi Kuesioner Perilaku\n(kebiasaan &amp; pola belajar)", shape=box, fillcolor="#ffffff"];
  hyb     [label="Penggabungan Hybrid\nProfil + Perilaku", shape=box, fillcolor="#e2efd9"];
  pref    [label="Pembentukan Preferensi User\n(tingkat kepentingan kriteria)", shape=box, fillcolor="#e2efd9"];
  roc     [label="Pembentukan Bobot Kriteria\nMetode ROC  (proses internal)", shape=box, fillcolor="#fbe5d6"];
  moora   [label="Perhitungan MOORA\nnormalisasi → pembobotan → nilai optimasi (Yi)", shape=box, fillcolor="#fbe5d6"];
  rank    [label="Perankingan 7 Aplikasi Belajar\n(Yi diurutkan menurun)", shape=box, fillcolor="#fbe5d6"];
  rekom   [label="Rekomendasi Personal User", shape=box, fillcolor="#d9e2f3", penwidth=2.0];
  detail  [label="Melihat Detail Aplikasi", shape=box, fillcolor="#ffffff"];
  end     [label="SELESAI", shape=oval, fillcolor="#d9e2f3", height=0.45];

  db [label="Basis Data\nkriteria &amp; nilai\n7 aplikasi belajar", shape=cylinder, fillcolor="#f2f2f2", fontsize=10];

  start -> reg -> cek;
  cek -> kp     [label="  Ya"];
  cek -> reg    [label="Tidak", constraint=false];
  kp -> kb -> hyb -> pref -> roc -> moora -> rank -> rekom -> detail -> end;

  db -> moora [style=dashed, arrowhead=vee, label=" matriks\n keputusan"];
  { rank=same; moora; db; }
}
