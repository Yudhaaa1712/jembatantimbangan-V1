<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Keuangan - Weighbridge</title>
  <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/sweetalert2.min.css">
  <link rel="stylesheet" href="/assets/css/bw-theme.css">
  <link rel="stylesheet" href="/assets/css/pages/keuangan-bw.css">
</head>
<body>
  <div id="site-header"></div>

  <div class="keuangan-container">
    <!-- Title Bar -->
    <div class="page-title-bar">
      <h2>BUKU KAS</h2>
      <span class="bulan-label" id="bulanLabel">-</span>
    </div>

    <!-- Saldo Cards -->
    <div class="saldo-grid">
      <div class="saldo-card saldo-utama">
        <div class="saldo-label">Saldo Saat Ini</div>
        <div class="saldo-value" id="saldoUtama">Rp 0</div>
      </div>
      <div class="saldo-card debit-card">
        <div class="saldo-label">Total Pemasukan (Bulan Ini)</div>
        <div class="saldo-value" id="totalDebit">Rp 0</div>
      </div>
      <div class="saldo-card kredit-card">
        <div class="saldo-label">Total Pengeluaran (Bulan Ini)</div>
        <div class="saldo-value" id="totalKredit">Rp 0</div>
      </div>
    </div>

    <!-- Toolbar: Filters + Actions -->
    <div class="toolbar-row">
      <div class="filter-group">
        <label>Bulan</label>
        <select id="filterBulan"></select>
        <label>Tahun</label>
        <select id="filterTahun"></select>
      </div>
      <div class="action-buttons">
        <button class="btn-tambah-saldo" onclick="showTambahSaldo()">+ Tambah Saldo</button>
        <button class="btn-pengeluaran" onclick="showTambahPengeluaran()">- Pengeluaran</button>
        <button class="btn-export" onclick="exportExcel()">Export Excel</button>
      </div>
    </div>

    <!-- Ledger Table -->
    <div class="ledger-wrapper">
      <div class="ledger-scroll">
        <table class="ledger-table" id="ledgerTable">
          <thead>
            <tr>
              <th class="text-center" style="width:50px;">No</th>
              <th style="width:110px;">Tanggal</th>
              <th>Keterangan</th>
              <th class="text-right" style="width:150px;">Debit</th>
              <th class="text-right" style="width:150px;">Kredit</th>
              <th class="text-right" style="width:170px;">Saldo</th>
              <th class="text-center" style="width:60px;">Aksi</th>
            </tr>
          </thead>
          <tbody id="ledgerBody">
            <tr>
              <td colspan="7" class="empty-state">
                <p>Memuat data...</p>
              </td>
            </tr>
          </tbody>
          <tfoot id="ledgerFoot">
            <tr>
              <td colspan="3" style="font-weight:800;">TOTAL</td>
              <td class="foot-debit" id="footDebit">Rp 0</td>
              <td class="foot-kredit" id="footKredit">Rp 0</td>
              <td class="foot-saldo" id="footSaldo">Rp 0</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <script src="/assets/js/jquery-3.7.1.min.js"></script>
  <script src="/assets/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/sweetalert2.min.js"></script>
  <script>
  // ─── Global State ───────────────────────────────────────────────────────────
  let currentUser = null;
  let ledgerData = null; // store for export

  // ─── Init ───────────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', async () => {
    await loadSession();
    initFilters();
    loadLedger();
    loadSaldo();
  });

  // ─── Session ────────────────────────────────────────────────────────────────
  async function loadSession() {
    try {
      const res = await fetch('/auth/session');
      currentUser = await res.json();
      if (!currentUser.loggedIn) { window.location.href = '/auth/login'; return; }
      if (currentUser.user_role !== 'admin') {
        Swal.fire({ icon: 'error', title: 'Akses Ditolak', text: 'Halaman ini hanya untuk admin' });
        setTimeout(() => window.location.href = '/timbangan/1', 1500);
        return;
      }
      document.getElementById('site-header').innerHTML = renderHeader('keuangan');
    } catch (e) {
      window.location.href = '/auth/login';
    }
  }

  function renderHeader(active) {
    const isAdmin = currentUser?.user_role === 'admin';
    return `<header class="site-header"><div class="header-top">
      <div class="header-brand"><div><h1 class="site-title">WEIGHBRIDGE</h1><p class="site-subtitle">Arroyan Jv Teknik</p></div>
        <nav class="header-nav">
          <a class="nav-item" href="/timbangan/1">Timbangan 1</a>
          <a class="nav-item" href="/timbangan/2">Timbangan 2</a>
          <a class="nav-item" href="/transaksi">Transaksi</a>
          <a class="nav-item" href="/pengiriman">Pengiriman Pabrik</a>
          ${isAdmin ? '<a class="nav-item active" href="/keuangan">Keuangan</a>' : ''}
          <a class="nav-item" href="/masterdata">Master Data</a>
          ${isAdmin ? '<a class="nav-item" href="/setup">Setup</a>' : ''}
        </nav></div>
      <div class="header-user"><span class="user-name">${currentUser?.nama_lengkap||''}</span><button class="btn-logout" onclick="doLogout()">Logout</button></div>
    </div></header>`;
  }

  async function doLogout() { await fetch('/auth/logout', { method: 'POST' }); window.location.href = '/auth/login'; }

  // ─── Filters ────────────────────────────────────────────────────────────────
  function initFilters() {
    const bulanSelect = document.getElementById('filterBulan');
    const tahunSelect = document.getElementById('filterTahun');
    const namaBulan = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    const now = new Date();

    namaBulan.forEach((nama, i) => {
      const opt = document.createElement('option');
      opt.value = i + 1;
      opt.textContent = nama;
      if (i + 1 === now.getMonth() + 1) opt.selected = true;
      bulanSelect.appendChild(opt);
    });

    for (let y = now.getFullYear(); y >= now.getFullYear() - 4; y--) {
      const opt = document.createElement('option');
      opt.value = y;
      opt.textContent = y;
      if (y === now.getFullYear()) opt.selected = true;
      tahunSelect.appendChild(opt);
    }

    bulanSelect.addEventListener('change', () => { loadLedger(); });
    tahunSelect.addEventListener('change', () => { loadLedger(); });
  }

  function getSelectedBulan() { return parseInt(document.getElementById('filterBulan').value); }
  function getSelectedTahun() { return parseInt(document.getElementById('filterTahun').value); }

  // ─── Format Rupiah ──────────────────────────────────────────────────────────
  function formatRp(num) {
    if (!num && num !== 0) return 'Rp 0';
    const val = Math.round(num);
    return 'Rp ' + val.toLocaleString('id-ID');
  }

  function formatTanggal(dateStr) {
    if (!dateStr) return '-';
    const d = new Date(dateStr);
    return d.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  // ─── Load Saldo ─────────────────────────────────────────────────────────────
  async function loadSaldo() {
    try {
      const res = await fetch('/kas/saldo');
      const r = await res.json();
      if (r.success) {
        document.getElementById('saldoUtama').textContent = formatRp(r.data.saldo);
      }
    } catch (e) { console.error('Load saldo error:', e); }
  }

  // ─── Load Ledger ────────────────────────────────────────────────────────────
  async function loadLedger() {
    const bulan = getSelectedBulan();
    const tahun = getSelectedTahun();
    const namaBulan = ['','Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

    document.getElementById('bulanLabel').textContent = `${namaBulan[bulan]} ${tahun}`;

    const tbody = document.getElementById('ledgerBody');
    tbody.innerHTML = '<tr><td colspan="7" class="empty-state"><p>Memuat data...</p></td></tr>';

    try {
      const res = await fetch(`/kas/ledger?bulan=${bulan}&tahun=${tahun}`);
      const r = await res.json();

      if (!r.success) {
        tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><p>${r.message}</p></td></tr>`;
        return;
      }

      ledgerData = r.data; // store for export

      const { data, saldo_awal, saldo_akhir, total_debit, total_kredit } = r.data;

      // Update cards
      document.getElementById('totalDebit').textContent = formatRp(total_debit);
      document.getElementById('totalKredit').textContent = formatRp(total_kredit);

      // Update footer
      document.getElementById('footDebit').textContent = formatRp(total_debit);
      document.getElementById('footKredit').textContent = formatRp(total_kredit);
      document.getElementById('footSaldo').textContent = formatRp(saldo_akhir);

      if (!data || data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><p>Belum ada data kas bulan ${namaBulan[bulan]} ${tahun}</p></td></tr>`;
        return;
      }

      let html = '';

      // Saldo awal row
      html += `<tr class="saldo-awal-row">
        <td class="col-no">-</td>
        <td class="col-tanggal">-</td>
        <td class="col-keterangan" style="font-style:italic;">SALDO AWAL BULAN</td>
        <td class="col-debit"></td>
        <td class="col-kredit"></td>
        <td class="col-saldo">${formatRp(saldo_awal)}</td>
        <td class="col-aksi"></td>
      </tr>`;

      data.forEach((row, i) => {
        const isDebit = row.jenis === 'masuk';
        const rowClass = isDebit ? 'row-debit' : '';

        let aksiHtml = '';
        if (row.is_manual) {
          aksiHtml = `<button class="btn-hapus-entry" onclick="hapusEntry(${row.id})" title="Hapus">✕</button>`;
        }

        html += `<tr class="${rowClass}">
          <td class="col-no">${i + 1}</td>
          <td class="col-tanggal">${formatTanggal(row.tanggal)}</td>
          <td class="col-keterangan">${escapeHtml(row.keterangan)}</td>
          <td class="col-debit">${isDebit ? formatRp(row.jumlah) : ''}</td>
          <td class="col-kredit">${!isDebit ? formatRp(row.jumlah) : ''}</td>
          <td class="col-saldo">${formatRp(row.saldo_setelah)}</td>
          <td class="col-aksi">${aksiHtml}</td>
        </tr>`;
      });

      tbody.innerHTML = html;

    } catch (e) {
      console.error('Load ledger error:', e);
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state"><p>Gagal memuat data</p></td></tr>';
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // ─── Tambah Saldo ───────────────────────────────────────────────────────────
  function showTambahSaldo() {
    Swal.fire({
      title: 'Tambah Saldo Kas',
      html: `
        <div style="text-align:left;">
          <div style="margin-bottom:12px;">
            <label style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#4a4a4a; display:block; margin-bottom:4px;">Jumlah (Rp)</label>
            <input type="text" id="swalJumlah" class="swal2-input" placeholder="Contoh: 150000000" style="margin:0; width:100%;" oninput="formatSwalRupiah(this)">
          </div>
          <div>
            <label style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#4a4a4a; display:block; margin-bottom:4px;">Keterangan</label>
            <input type="text" id="swalKeterangan" class="swal2-input" placeholder="Contoh: TAMBAH SALDO" value="TAMBAH SALDO" style="margin:0; width:100%; text-transform:uppercase;">
          </div>
        </div>
      `,
      showCancelButton: true,
      confirmButtonColor: '#16a34a',
      cancelButtonColor: '#6b7280',
      confirmButtonText: 'Tambah',
      cancelButtonText: 'Batal',
      focusConfirm: false,
      preConfirm: () => {
        const jumlah = parseSwalRupiah(document.getElementById('swalJumlah').value);
        const keterangan = document.getElementById('swalKeterangan').value.trim();
        if (!jumlah || jumlah <= 0) {
          Swal.showValidationMessage('Jumlah harus lebih dari 0');
          return false;
        }
        return { jumlah, keterangan };
      }
    }).then(async (result) => {
      if (result.isConfirmed) {
        try {
          const res = await fetch('/kas/tambah', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(result.value)
          });
          const r = await res.json();
          if (r.success) {
            Swal.fire({ icon: 'success', title: 'Berhasil', text: r.message, timer: 2000, showConfirmButton: false });
            loadLedger();
            loadSaldo();
          } else {
            Swal.fire({ icon: 'error', title: 'Gagal', text: r.message });
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Error', text: 'Gagal menambah saldo' });
        }
      }
    });
  }

  // ─── Tambah Pengeluaran ─────────────────────────────────────────────────────
  function showTambahPengeluaran() {
    Swal.fire({
      title: 'Catat Pengeluaran',
      html: `
        <div style="text-align:left;">
          <div style="margin-bottom:12px;">
            <label style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#4a4a4a; display:block; margin-bottom:4px;">Keterangan</label>
            <input type="text" id="swalKetPengeluaran" class="swal2-input" placeholder="Contoh: UANG JALAN GALUH" style="margin:0; width:100%; text-transform:uppercase;">
          </div>
          <div>
            <label style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#4a4a4a; display:block; margin-bottom:4px;">Jumlah (Rp)</label>
            <input type="text" id="swalJmlPengeluaran" class="swal2-input" placeholder="Contoh: 550000" style="margin:0; width:100%;" oninput="formatSwalRupiah(this)">
          </div>
        </div>
      `,
      showCancelButton: true,
      confirmButtonColor: '#dc2626',
      cancelButtonColor: '#6b7280',
      confirmButtonText: 'Catat Pengeluaran',
      cancelButtonText: 'Batal',
      focusConfirm: false,
      preConfirm: () => {
        const keterangan = document.getElementById('swalKetPengeluaran').value.trim();
        const jumlah = parseSwalRupiah(document.getElementById('swalJmlPengeluaran').value);
        if (!keterangan) {
          Swal.showValidationMessage('Keterangan harus diisi');
          return false;
        }
        if (!jumlah || jumlah <= 0) {
          Swal.showValidationMessage('Jumlah harus lebih dari 0');
          return false;
        }
        return { jumlah, keterangan };
      }
    }).then(async (result) => {
      if (result.isConfirmed) {
        try {
          const res = await fetch('/kas/pengeluaran', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(result.value)
          });
          const r = await res.json();
          if (r.success) {
            Swal.fire({ icon: 'success', title: 'Berhasil', text: r.message, timer: 2000, showConfirmButton: false });
            loadLedger();
            loadSaldo();
          } else {
            Swal.fire({ icon: 'error', title: 'Gagal', text: r.message });
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Error', text: 'Gagal mencatat pengeluaran' });
        }
      }
    });
  }

  // ─── Hapus Entry ────────────────────────────────────────────────────────────
  async function hapusEntry(id) {
    const result = await Swal.fire({
      title: 'Hapus entry ini?',
      text: 'Entry akan dihapus dan saldo akan dihitung ulang',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc2626',
      cancelButtonColor: '#6b7280',
      confirmButtonText: 'Ya, Hapus',
      cancelButtonText: 'Batal'
    });

    if (result.isConfirmed) {
      try {
        const res = await fetch(`/kas/hapus/${id}`, { method: 'DELETE' });
        const r = await res.json();
        if (r.success) {
          Swal.fire({ icon: 'success', title: 'Dihapus', text: 'Entry berhasil dihapus', timer: 1500, showConfirmButton: false });
          loadLedger();
          loadSaldo();
        } else {
          Swal.fire({ icon: 'error', title: 'Gagal', text: r.message });
        }
      } catch (e) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Gagal menghapus entry' });
      }
    }
  }

  // ─── Export Excel ───────────────────────────────────────────────────────────
  function exportExcel() {
    if (!ledgerData || !ledgerData.data || ledgerData.data.length === 0) {
      Swal.fire({ icon: 'warning', title: 'Kosong', text: 'Tidak ada data untuk di-export' });
      return;
    }

    const bulan = getSelectedBulan();
    const tahun = getSelectedTahun();
    const namaBulan = ['','Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    const { data, saldo_awal, saldo_akhir, total_debit, total_kredit } = ledgerData;

    // Build HTML table for Excel
    let html = `
    <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel">
    <head><meta charset="UTF-8">
    <style>
      td, th { font-family: Arial; font-size: 11px; border: 1px solid #000; padding: 5px 8px; }
      th { background: #1a1a1a; color: #fff; font-weight: bold; text-align: center; }
      .title { font-size: 16px; font-weight: bold; border: none; text-align: center; }
      .subtitle { font-size: 12px; border: none; text-align: center; color: #666; }
      .debit { color: #16a34a; font-weight: bold; }
      .kredit { color: #dc2626; font-weight: bold; }
      .saldo { font-weight: bold; }
      .total-row td { background: #f0f0f0; font-weight: bold; font-size: 12px; }
      .saldo-awal td { background: #fefce8; font-style: italic; }
      .right { text-align: right; }
      .center { text-align: center; }
    </style>
    </head><body>
    <table>
      <tr><td colspan="6" class="title">KEUANGAN ${namaBulan[bulan].toUpperCase()} ${tahun}</td></tr>
      <tr><td colspan="6" class="subtitle">Dicetak: ${new Date().toLocaleDateString('id-ID')} ${new Date().toLocaleTimeString('id-ID')}</td></tr>
      <tr><td colspan="6"></td></tr>
      <tr>
        <th style="width:40px;">NO</th>
        <th style="width:90px;">TANGGAL</th>
        <th style="width:250px;">KETERANGAN</th>
        <th style="width:120px;">DEBIT</th>
        <th style="width:120px;">KREDIT</th>
        <th style="width:140px;">SALDO</th>
      </tr>
      <tr class="saldo-awal">
        <td class="center">-</td>
        <td>-</td>
        <td>SALDO AWAL BULAN</td>
        <td></td>
        <td></td>
        <td class="right saldo">${formatRp(saldo_awal)}</td>
      </tr>`;

    data.forEach((row, i) => {
      const isDebit = row.jenis === 'masuk';
      html += `<tr>
        <td class="center">${i + 1}</td>
        <td>${formatTanggal(row.tanggal)}</td>
        <td>${escapeHtml(row.keterangan)}</td>
        <td class="right ${isDebit ? 'debit' : ''}">${isDebit ? formatRp(row.jumlah) : ''}</td>
        <td class="right ${!isDebit ? 'kredit' : ''}">${!isDebit ? formatRp(row.jumlah) : ''}</td>
        <td class="right saldo">${formatRp(row.saldo_setelah)}</td>
      </tr>`;
    });

    html += `
      <tr class="total-row">
        <td colspan="3" style="font-weight:bold;">TOTAL</td>
        <td class="right debit">${formatRp(total_debit)}</td>
        <td class="right kredit">${formatRp(total_kredit)}</td>
        <td class="right saldo">${formatRp(saldo_akhir)}</td>
      </tr>
    </table></body></html>`;

    // Download
    const blob = new Blob([html], { type: 'application/vnd.ms-excel' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Keuangan_${namaBulan[bulan]}_${tahun}.xls`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // ─── Rupiah Input Helpers ───────────────────────────────────────────────────
  function formatSwalRupiah(el) {
    let value = el.value.replace(/[^0-9]/g, '');
    if (value) {
      el.value = parseInt(value).toLocaleString('id-ID');
    }
  }

  function parseSwalRupiah(str) {
    if (!str) return 0;
    return parseInt(str.replace(/[^0-9]/g, '')) || 0;
  }
  </script>
</body>
</html>
