# Deny access to session files
<Files "*">
    Require all denied
</Files>

# Prevent directory listing
Options -Indexes

# No cache for .htaccess itself
<Files ".htaccess">
    Require all granted
</Files>

# Set session file permissions
php_value session.upload_progress.cleanup On
php_value session.upload_progress.name PHP_SESSION_UPLOAD_PROGRESS